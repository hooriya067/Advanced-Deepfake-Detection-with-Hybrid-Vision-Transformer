    "def train_stage3():\n",
    "    device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
    "    model = Stage3Hybrid().to(device)\n",
    "            \n",
    "\n",
    "  # -------- Transforms --------\n",
    "    tfm_raw_train = transforms.Compose([\n",
    "        transforms.Resize((224,224)),\n",
    "        RandomJPEG(quality_min=30, quality_max=100, p=0.7),\n",
    "        transforms.ToTensor(),   # raw [0,1] for FFT\n",
    "    ])\n",
    "    \n",
    "    tfm_rgb_train = transforms.Compose([\n",
    "        transforms.Resize((224,224)),\n",
    "        RandomJPEG(quality_min=30, quality_max=100, p=0.7),\n",
    "        transforms.RandomHorizontalFlip(),\n",
    "        transforms.ColorJitter(0.1, 0.1, 0.05, 0.02),          # smaller than your old one\n",
    "        transforms.GaussianBlur(kernel_size=3, sigma=(0.1, 1.0)), # mild blur\n",
    "        transforms.ToTensor(),\n",
    "        transforms.Normalize([0.485,0.456,0.406],[0.229,0.224,0.225]),\n",
    "    ])\n",
    "    \n",
    "    tfm_raw_eval = transforms.Compose([\n",
    "        transforms.Resize((224,224)),\n",
    "        transforms.ToTensor(),\n",
    "    ])\n",
    "    \n",
    "    tfm_rgb_eval = transforms.Compose([\n",
    "        transforms.Resize((224,224)),\n",
    "        transforms.ToTensor(),\n",
    "        transforms.Normalize([0.485,0.456,0.406],\n",
    "                             [0.229,0.224,0.225]),\n",
    "    ])\n",
    "    \n",
    "\n",
    "    # ---- Dataset ---- \n",
    "    trainset = DualViewImageFolder(\n",
    "        \"/kaggle/input/140k-real-and-fake-faces/real_vs_fake/real-vs-fake/train\",\n",
    "        tfm_raw=tfm_raw_train,\n",
    "        tfm_rgb=tfm_rgb_train\n",
    "    )\n",
    "    \n",
    "    valset = DualViewImageFolder(\n",
    "        \"/kaggle/input/140k-real-and-fake-faces/real_vs_fake/real-vs-fake/valid\",\n",
    "        tfm_raw=tfm_raw_eval,\n",
    "        tfm_rgb=tfm_rgb_eval\n",
    "    )\n",
    "    \n",
    "    testset = DualViewImageFolder(\n",
    "        \"/kaggle/input/140k-real-and-fake-faces/real_vs_fake/real-vs-fake/test\",\n",
    "        tfm_raw=tfm_raw_eval,\n",
    "        tfm_rgb=tfm_rgb_eval\n",
    "    )\n",
    "\n",
    "\n",
    "\n",
    "    trainloader = DataLoader(trainset, batch_size=16, shuffle=True, num_workers=0)\n",
    "    valloader   = DataLoader(valset, batch_size=16, shuffle=False, num_workers=2)\n",
    "    testloader = DataLoader(testset, batch_size=16, shuffle=False, num_workers=2)\n",
    "\n",
    "   \n",
    "    print(\"class_to_idx:\", trainset.class_to_idx)\n",
    "    real_idx = trainset.class_to_idx[\"real\"]\n",
    "\n",
    "\n",
    "    # ---- Optimiser / loss / scaler ----\n",
    "    opt = optim.AdamW(model.parameters(), lr=1e-4, weight_decay=1e-4)\n",
    "    criterion = nn.CrossEntropyLoss()\n",
    "    epochs, best_auc = 10, 0\n",
    "\n",
    "    use_cuda = torch.cuda.is_available()\n",
    "    scaler = torch.amp.GradScaler(enabled=use_cuda)\n",
    "    \n",
    "    for epoch in range(epochs):\n",
    "        model.train()\n",
    "        running_loss = 0.0\n",
    "    \n",
    "        for x_rgb, x_raw, lbls in tqdm(trainloader, desc=f\"Epoch {epoch+1}/{epochs}\", ncols=100):\n",
    "            x_rgb = x_rgb.to(device, non_blocking=True)\n",
    "            x_raw = x_raw.to(device, non_blocking=True)\n",
    "            lbls  = lbls.to(device, non_blocking=True)\n",
    "    \n",
    "            opt.zero_grad(set_to_none=True)\n",
    "    \n",
    "            with torch.amp.autocast(device_type=\"cuda\", enabled=use_cuda):\n",
    "                logits = model(x_rgb, x_raw)\n",
    "                loss = criterion(logits, lbls)\n",
    "    \n",
    "            scaler.scale(loss).backward()\n",
    "            scaler.step(opt)\n",
    "            scaler.update()\n",
    "    \n",
    "            running_loss += loss.item()\n",
    "\n",
    "\n",
    "        # ---- Validation ----\n",
    "        model.eval()\n",
    "        y_true, y_prob = [], []\n",
    "        \n",
    "        with torch.no_grad():\n",
    "            for x_rgb, x_raw, lbls in valloader:\n",
    "                x_rgb = x_rgb.to(device, non_blocking=True)\n",
    "                x_raw = x_raw.to(device, non_blocking=True)\n",
    "        \n",
    "                probs = torch.softmax(model(x_rgb, x_raw), dim=1)[:, real_idx].cpu().numpy()\n",
    "        \n",
    "                y_true.extend(lbls.numpy())\n",
    "                y_prob.extend(probs)\n",
    "\n",
    "        \n",
    "\n",
    "        auc, f1, eer, acc = calc_metrics(np.array(y_true), np.array(y_prob))\n",
    "        print(f\"Epoch {epoch+1}: loss={running_loss/len(trainloader):.4f} | \"\n",
    "              f\"AUROC={auc:.3f} | F1={f1:.3f} | EER={eer:.3f} | ACC={acc:.3f}\")\n",
    "\n",
    "        ckpt_path = f\"/kaggle/working/stage3_epoch{epoch+1}.pth\"\n",
    "        torch.save(model.state_dict(), ckpt_path)\n",
    "        if auc > best_auc:\n",
    "            best_auc = auc\n",
    "            torch.save(model.state_dict(), \"/kaggle/working/best_auc_stage3.pth\")\n",
    "            print(f\"★ New best AUC {best_auc:.3f} (ACC={acc:.3f})\")\n",
    "\n",
    "    print(\"\\nTraining complete!\")\n",
    "    print(f\"Best model achieved: AUROC={best_auc:.3f}\")\n",
    "    return model, testloader, real_idx\n"
   ]
