    "class DualViewImageFolder(datasets.ImageFolder):\n",
    "    \"\"\"\n",
    "    Returns:\n",
    "      x_rgb: normalized RGB tensor (for ResNet)\n",
    "      x_raw: raw [0,1] tensor (for FFT)\n",
    "      y: label\n",
    "    \"\"\"\n",
    "    def __init__(self, root, tfm_raw, tfm_rgb):\n",
    "        super().__init__(root, transform=None)\n",
    "        self.tfm_raw = tfm_raw\n",
    "        self.tfm_rgb = tfm_rgb\n",
    "\n",
    "    def __getitem__(self, index):\n",
    "        path, y = self.samples[index]\n",
    "        img = self.loader(path)\n",
    "\n",
    "        x_raw = self.tfm_raw(img)\n",
    "        x_rgb = self.tfm_rgb(img)\n",
    "\n",
    "        return x_rgb, x_raw, y\n"
