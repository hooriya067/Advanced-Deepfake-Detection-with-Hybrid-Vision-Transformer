    "class FFTMagnitude(nn.Module):\n",
    "    def forward(self, x_raw):\n",
    "        # x_raw: [B,3,H,W] in [0,1]\n",
    "        f = torch.fft.fft2(x_raw)\n",
    "        f = torch.fft.fftshift(f)\n",
    "        mag = torch.abs(f)\n",
    "        mag = torch.log1p(mag)\n",
    "\n",
    "        # per-image normalization (helps stability)\n",
    "        mag = (mag - mag.mean(dim=(2,3), keepdim=True)) / (mag.std(dim=(2,3), keepdim=True) + 1e-6)\n",
    "        return mag\n",
    "\n"
   ]
