    "def evaluate(model, loader, real_idx, tag=\"TEST\"):\n",
    "    device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
    "    model.eval()\n",
    "    y_true, y_prob = [], []\n",
