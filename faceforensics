    "class Stage3Hybrid(nn.Module):\n",
    "    def __init__(self, embed_dim=512, num_heads=8, num_layers=4, use_fft=True):\n",
    "        super().__init__()\n",
    "        self.use_fft = use_fft\n",
    "\n",
    "        self.resnet = models.resnet50(weights=models.ResNet50_Weights.IMAGENET1K_V1)\n",
    "        self.resnet = nn.Sequential(*list(self.resnet.children())[:-2])\n",
    "\n",
    "        self.fft_layer = FFTMagnitude()\n",
    "\n",
    "        self.proj_rgb = nn.Conv2d(2048, embed_dim, 1)\n",
    "        self.proj_fft = nn.Conv2d(3, embed_dim, 1)\n",
    "\n",
    "        enc_layer = nn.TransformerEncoderLayer(\n",
    "            d_model=embed_dim, nhead=num_heads, dim_feedforward=embed_dim*4,\n",
    "            batch_first=True, norm_first=True\n",
    "        )\n",
    "        self.transformer = nn.TransformerEncoder(enc_layer, num_layers=num_layers)\n",
    "\n",
    "        self.pos_embed = nn.Parameter(torch.randn(1, 200, embed_dim))\n",
    "\n",
    "        self.cls_head = nn.Sequential(\n",
    "            nn.LayerNorm(embed_dim),\n",
    "            nn.Linear(embed_dim, 2)\n",
    "        )\n",
    "\n",
    "    def forward(self, x_rgb, x_raw):\n",
    "        # RGB tokens\n",
    "        rgb_feat = self.resnet(x_rgb)\n",
    "        rgb_map = self.proj_rgb(rgb_feat)\n",
    "        rgb_map = F.adaptive_avg_pool2d(rgb_map, (10,10))\n",
    "        rgb_tok = rgb_map.flatten(2).transpose(1,2)  # [B,100,512]\n",
    "\n",
    "        if self.use_fft:\n",
    "            fft_img = self.fft_layer(x_raw)\n",
    "            fft_img = (fft_img - fft_img.mean(dim=(2,3), keepdim=True)) / (fft_img.std(dim=(2,3), keepdim=True) + 1e-6)\n",
    "            fft_map = self.proj_fft(fft_img)\n",
    "            fft_map = F.adaptive_avg_pool2d(fft_map, (10,10))\n",
    "            fft_tok = fft_map.flatten(2).transpose(1,2)\n",
    "        else:\n",
    "            fft_tok = torch.zeros_like(rgb_tok)\n",
    "\n",
    "        tokens = torch.cat([rgb_tok, fft_tok], dim=1)               # [B,200,512]\n",
    "        tokens = tokens + self.pos_embed[:, :tokens.size(1), :]\n",
    "\n",
    "        out = self.transformer(tokens).mean(dim=1)\n",
    "        return self.cls_head(out)\n"
   ]
