    "class FFTMagnitude(nn.Module):\n",
    "    \"\"\"Compute log-scaled magnitude spectrum of input images.\"\"\"\n",
    "    def forward(self, x):\n",
    "        # x: [B, 3, H, W]\n",
    "        f = torch.fft.fft2(x)\n",
    "        fshift = torch.fft.fftshift(f)\n",
    "        mag = torch.abs(fshift)\n",
    "        mag = torch.log1p(mag)\n",
    "        return mag\n"
   ]
