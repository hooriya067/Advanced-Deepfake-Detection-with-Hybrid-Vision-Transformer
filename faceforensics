    "from pathlib import Path\n",
    "from PIL import Image\n",
    "from tqdm import tqdm\n",
    "import torch\n",
    "from facenet_pytorch import MTCNN\n",
    "\n",
    "DATASET_ROOT = Path(\"/kaggle/input/ffpp-c23-frames-10-per-video/ffpp_kaggle\")\n",
    "OUT_ROOT = Path(\"/kaggle/working/cropped_png\")\n",
    "\n",
    "device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
    "print(\"Device:\", device)\n",
    "\n",
    "mtcnn = MTCNN(image_size=224, margin=20, min_face_size=40, thresholds=[0.6,0.7,0.7], device=device)\n",
    "\n",
    "splits = [\"train\",\"val\",\"test\"]\n",
    "classes = [\"real\",\"fake\"]\n",
    "\n",
    "def crop_split(split, cls):\n",
    "    inp = DATASET_ROOT / split / cls\n",
    "    assert inp.exists(), f\"Missing folder: {inp}\"\n",
    "    out = OUT_ROOT / split / cls\n",
    "    out.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "    files = list(inp.glob(\"*.jpg\")) + list(inp.glob(\"*.png\")) + list(inp.glob(\"*.jpeg\"))\n",
    "    print(f\"{split}/{cls}: {len(files)} images\")\n",
    "\n",
    "    kept = 0\n",
    "    for f in tqdm(files):\n",
    "        try:\n",
    "            img = Image.open(f).convert(\"RGB\")\n",
    "        except Exception:\n",
    "            continue\n",
    "\n",
    "        face = mtcnn(img)\n",
    "        if face is None:\n",
    "            continue\n",
    "\n",
    "        face_img = Image.fromarray((face.permute(1,2,0).cpu().numpy() * 255).astype(\"uint8\"))\n",
    "        face_img = face_img.convert(\"RGB\")  # safety\n",
    "        face_img.save(str(out / (f.stem + \".png\")))  # PNG avoids JPEG encoder issues\n",
    "        kept += 1\n",
    "\n",
    "    print(f\"Saved: {kept}\")\n",
    "\n",
    "for s in splits:\n",
    "    for c in classes:\n",
    "        crop_split(s, c)\n",
    "\n",
    "print(\"Done:\", OUT_ROOT)\n"
   ]
