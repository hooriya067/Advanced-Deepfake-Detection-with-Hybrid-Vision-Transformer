    "def train_stage3(\n",
    "    data_root,\n",
    "    pretrained_path=None,\n",
    "    use_fft=True,\n",
    "    epochs=5,\n",
    "    batch_size=16,\n",
    "    lr=1e-5,\n",
    "    run_tag=\"run\"\n",
    "):\n",
    "\n",
    "    device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
    "    model = Stage3Hybrid(use_fft=use_fft).to(device)\n",
    "\n",
    "    if pretrained_path is not None:\n",
    "        state = torch.load(pretrained_path, map_location=device)\n",
    "        model.load_state_dict(state, strict=True)\n",
    "        print(\"Loaded pretrained 140k weights\")\n",
    "        \n",
    "    for name, param in model.resnet.named_parameters():\n",
    "        if \"layer3\" in name or \"layer4\" in name:\n",
    "            param.requires_grad = True\n",
    "        else:\n",
    "            param.requires_grad = False\n",
    "\n",
    "\n",
    "\n",
    "    # transforms\n",
    "    tfm_raw = transforms.Compose([\n",
    "        transforms.Resize((224,224)),\n",
    "        transforms.ToTensor(),   # NO normalize\n",
    "    ])\n",
    "\n",
    "\n",
    "    tfm_rgb_train = transforms.Compose([\n",
    "        transforms.Resize((224,224)),\n",
    "        transforms.RandomHorizontalFlip(),\n",
    "        transforms.ColorJitter(0.2,0.2,0.1,0.05),\n",
    "        transforms.GaussianBlur(kernel_size=3, sigma=(0.1, 2.0)),\n",
    "        transforms.ToTensor(),\n",
    "        transforms.Normalize([0.485,0.456,0.406],[0.229,0.224,0.225])\n",
    "    ])\n",
    "\n",
    "\n",
    "    tfm_rgb_eval = transforms.Compose([\n",
    "        transforms.Resize((224,224)),\n",
    "        transforms.ToTensor(),\n",
    "        transforms.Normalize([0.485,0.456,0.406],[0.229,0.224,0.225])\n",
    "    ])\n",
    "\n",
    "    trainset = DualViewImageFolder(os.path.join(data_root, \"train\"), tfm_raw, tfm_rgb_train)\n",
    "    valset = DualViewImageFolder(os.path.join(data_root, \"val\"), tfm_raw, tfm_rgb_eval)\n",
    "    testset  = DualViewImageFolder(os.path.join(data_root, \"test\"),  tfm_raw, tfm_rgb_eval)\n",
    "\n",
    "    print(\"class_to_idx:\", trainset.class_to_idx)\n",
    "    real_idx = trainset.class_to_idx[\"real\"]\n",
    "\n",
    "\n",
    "    trainloader = DataLoader(trainset, batch_size=batch_size, shuffle=True,  num_workers=2, pin_memory=True)\n",
    "    valloader   = DataLoader(valset,   batch_size=batch_size, shuffle=False, num_workers=2, pin_memory=True)\n",
    "    testloader  = DataLoader(testset,  batch_size=batch_size, shuffle=False, num_workers=2, pin_memory=True)\n",
    "\n",
    "    opt = optim.AdamW(model.parameters(), lr=lr, weight_decay=1e-5)\n",
    "    criterion = nn.CrossEntropyLoss()\n",
    "    use_cuda = torch.cuda.is_available()\n",
    "    device = \"cuda\" if use_cuda else \"cpu\"\n",
    "    \n",
    "    scaler = torch.amp.GradScaler(enabled=use_cuda)\n",
    "\n",
    "    best_auc = 0.0\n",
    "\n",
    "    for epoch in range(epochs):\n",
    "        model.train()\n",
    "        running_loss = 0.0\n",
    "\n",
    "        for x_rgb, x_raw, y in tqdm(trainloader, desc=f\"{run_tag} Epoch {epoch+1}/{epochs}\", ncols=100):\n",
    "            x_rgb, x_raw, y = x_rgb.to(device), x_raw.to(device), y.to(device)\n",
    "\n",
    "            opt.zero_grad(set_to_none=True)\n",
    "            with torch.amp.autocast(device_type=\"cuda\", enabled=use_cuda):\n",
    "                logits = model(x_rgb, x_raw)\n",
    "                loss = criterion(logits, y)\n",
    "            scaler.scale(loss).backward()\n",
    "            scaler.step(opt)\n",
    "            scaler.update()\n",
    "            running_loss += loss.item()\n",
    "\n",
    "        # validation\n",
    "        model.eval()\n",
    "        y_true, y_prob = [], []\n",
    "        with torch.no_grad():\n",
    "            for x_rgb, x_raw, y in valloader:\n",
    "                x_rgb, x_raw = x_rgb.to(device), x_raw.to(device)\n",
    "                probs = torch.softmax(model(x_rgb, x_raw), dim=1)[:, real_idx].cpu().numpy()\n",
    "                y_true.extend(y.numpy())\n",
    "                y_prob.extend(probs)\n",
    "\n",
    "        auc, f1, eer, acc = calc_metrics(np.array(y_true), np.array(y_prob))\n",
    "        print(f\"{run_tag} Epoch {epoch+1}: loss={running_loss/len(trainloader):.4f} | AUROC={auc:.3f} | F1={f1:.3f} | EER={eer:.3f} | ACC={acc:.3f}\")\n",
    "\n",
    "        # (optional) save epoch ckpt\n",
    "        torch.save(model.state_dict(), f\"/kaggle/working/{run_tag}_epoch{epoch+1}.pth\")\n",
    "\n",
    "     \n",
    "        # save best for this run_tag\n",
    "        if auc > best_auc:\n",
    "            best_auc = auc\n",
    "        \n",
    "            # 1) simple weights (classic)\n",
    "            torch.save(\n",
    "                model.state_dict(),\n",
    "                f\"/kaggle/working/best_{run_tag}.pth\"\n",
    "            )\n",
    "        \n",
    "            # 2) richer checkpoint (recommended)\n",
    "            torch.save(\n",
    "                {\n",
    "                    \"state_dict\": model.state_dict(),\n",
    "                    \"use_fft\": use_fft,\n",
    "                    \"embed_dim\": 512,\n",
    "                    \"num_layers\": 4,\n",
    "                    \"num_heads\": 8,\n",
    "                    \"epoch\": epoch + 1,\n",
    "                    \"best_auc\": best_auc,\n",
    "                    \"run_tag\": run_tag,\n",
    "                },\n",
    "                f\"/kaggle/working/best_{run_tag}.ckpt\"\n",
    "            )\n",
    "        \n",
    "            print(f\" New best {run_tag}: AUROC={best_auc:.3f}\")\n",
    "\n",
    "\n",
    "    return model, testloader, real_idx\n"
   ]
